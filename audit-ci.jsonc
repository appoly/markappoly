{
  "$schema": "https://raw.githubusercontent.com/IBM/audit-ci/main/docs/schema.json",
  // Fail on high/critical advisories in shipped (non-dev) dependencies.
  "high": true,
  "skip-dev": true,
  // Advisories with no upstream fix can be allowlisted here by GHSA id, with a
  // comment explaining the exposure. Prefer removing the package instead:
  // image-size (pulled in by remark-docx) is replaced by an empty stub via
  // `overrides` in package.json, with shims/image-size aliased in its place.
  "allowlist": []
}
